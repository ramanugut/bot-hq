diff --git a/web/src/styles/polish.css b/web/src/styles/polish.css
new file mode 100644
index 0000000..b563558
--- /dev/null
+++ b/web/src/styles/polish.css
@@ -0,0 +1,200 @@
+/* Botly polish layer. Loads last (after refinement.css).
+   Brings the app icon's own colours into the app: ink (#111318) surfaces and one mint accent (#7CF0C4).
+   Look and feel only: no layout, navigation or behaviour changes. Remove the import in main.tsx to undo it. */
+
+/* ---------- tokens ---------- */
+:root {
+  --color-accent: #0E9F78;
+  --color-accent-soft: #0E9F781F;
+  --color-accent-ring: #0E9F7838;
+  --color-on-accent: #FFFFFF;
+  --color-border-focus: #0E9F78;
+  --color-bg-chrome: #FAFBFC;
+  --color-bg-sidebar: #F3F4F6;
+  --radius-md: 14px;
+  --polish-ambient: none;
+}
+:root[data-theme='dark'] {
+  --color-accent: #7CF0C4;
+  --color-accent-soft: #7CF0C41A;
+  --color-accent-ring: #7CF0C433;
+  --color-on-accent: #0B1512;
+  --color-border-focus: #7CF0C4;
+
+  /* Ink surfaces: three clear steps instead of near-identical greys. */
+  --color-bg-sidebar: #0B0D11;
+  --color-bg-chrome: #0F1116;
+  --color-bg-pane: #151920;
+  --color-bg-elevated: #1A1F27;
+  --color-bg-elevated-hover: #222832;
+  --color-bg-active-solid: #1E242D;
+  --color-bg-active: #E6EDF714;
+  --color-bg-tertiary: #E6EDF70B;
+  --color-bg-hover: #E6EDF70F;
+  --color-bg-subtle: #E6EDF706;
+  --color-bubble-agent: #E6EDF70D;
+
+  --color-text-primary: #F1F4F8;
+  --color-text-secondary: #F1F4F8B0;
+  --color-text-tertiary: #F1F4F88C;
+  --color-text-quaternary: #F1F4F85C;
+  --color-ink: #F1F4F8;
+  --color-primary: #F1F4F8;
+  --color-on-primary: #0F1116;
+  --color-border-secondary: #DCE6F41C;
+  --color-border-tertiary: #DCE6F411;
+  --color-border-primary: #DCE6F43A;
+
+  --polish-ambient: radial-gradient(900px 420px at 50% -160px, #7CF0C40D, transparent 70%);
+}
+
+/* ---------- type and small global details ---------- */
+body { letter-spacing: 0; text-rendering: optimizeLegibility; }
+::selection { background: var(--color-accent-ring); }
+* { scrollbar-color: var(--color-border-secondary) transparent; }
+*::-webkit-scrollbar { width: 8px; height: 8px; }
+*::-webkit-scrollbar-thumb { background: var(--color-border-secondary); border-radius: 8px; border: 2px solid transparent; background-clip: padding-box; }
+*::-webkit-scrollbar-thumb:hover { background: var(--color-border-primary); background-clip: padding-box; }
+*::-webkit-scrollbar-track { background: transparent; }
+
+/* One focus style everywhere: a soft accent ring. Text fields show it on their container instead. */
+:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
+.composer__input:focus-visible, .text-input:focus-visible, .chats__search:focus-visible { outline: none; }
+.text-input { border-radius: 10px; transition: border-color 140ms var(--ease-out), box-shadow 140ms var(--ease-out); }
+.text-input:focus { border-color: var(--color-accent); box-shadow: 0 0 0 3px var(--color-accent-ring); }
+
+/* ---------- sidebar ---------- */
+.sidebar__brand {
+  display: inline-flex; align-items: center; gap: 8px; margin-right: auto; padding-left: 2px;
+  font-size: 15px; font-weight: 600; letter-spacing: -0.2px; color: var(--color-ink); user-select: none;
+}
+.sidebar__brand img { width: 22px; height: 22px; border-radius: 7px; display: block; }
+.sidebar:not(.is-collapsed) .sidebar__controls > button:first-child { margin-right: 0; }
+
+.bot-row { position: relative; height: 58px; padding: 8px 10px; border-radius: 14px; }
+.bot-row.is-selected { background: var(--color-bg-active); box-shadow: inset 0 0 0 0.5px var(--color-border-secondary); }
+.bot-row.is-selected::before {
+  content: ''; position: absolute; left: -12px; top: 16px; bottom: 16px; width: 3px; border-radius: 0 3px 3px 0;
+  background: var(--color-accent);
+}
+.bot-row__name { letter-spacing: -0.05px; }
+.bot-row__preview { color: var(--color-text-tertiary); }
+.status-dot.is-unread { background: var(--color-accent); }
+.sidebar-island.is-active { box-shadow: inset 0 0 0 0.5px var(--color-border-secondary); }
+.account__initials { background: var(--color-accent-soft); color: var(--color-accent); box-shadow: inset 0 0 0 0.5px var(--color-accent-ring); }
+
+/* ---------- chat ---------- */
+.chat { background: var(--polish-ambient), var(--color-bg-chrome); }
+/* Messages fade out before they reach the floating header instead of sliding under it. */
+.chat__header {
+  height: 76px; align-items: flex-start; padding-top: 12px;
+  background: linear-gradient(180deg, var(--color-bg-chrome) 0%, var(--color-bg-chrome) 52%, transparent 100%);
+}
+.transcript { padding-top: 76px; scroll-padding-top: 76px; }
+.chat__pill { backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
+.chat__pill-name { letter-spacing: -0.05px; }
+
+.transcript__col { gap: 14px; }
+.bubble { max-width: 620px; padding: 9px 14px; line-height: 23px; letter-spacing: 0; }
+.bubble.is-agent {
+  background: var(--color-bubble-agent);
+  box-shadow: inset 0 0 0 0.5px var(--color-border-tertiary);
+}
+.bubble.is-user { box-shadow: inset 0 1px #FFFFFF24, 0 1px 2px #0000001F; }
+.md pre { border-radius: 10px; box-shadow: inset 0 0 0 0.5px var(--color-border-tertiary); }
+.md code { border-radius: 5px; }
+.notice { border-radius: 999px; padding: 6px 14px; }
+.system-event, .divider { color: var(--color-text-tertiary); }
+.steps__toggle { height: 28px; padding: 0 10px 0 12px; }
+
+/* Composer: the ring sits on the whole box; the text field itself never draws an outline. */
+.composer {
+  min-height: 52px; padding: 0 10px; border-radius: 26px;
+  transition: border-color 160ms var(--ease-out), box-shadow 160ms var(--ease-out);
+}
+.composer:focus-within {
+  border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border-primary));
+  box-shadow: 0 0 0 3px var(--color-accent-soft), var(--shadow-composer);
+}
+.composer__input::placeholder { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.composer__input { padding: 16px 2px; font-size: 15px; line-height: 20px; letter-spacing: 0; }
+.composer__right { padding: 10px 0; }
+.composer__plus-anchor { padding: 10px 0; }
+.composer__btn, .composer__cta { width: 32px; height: 32px; }
+.composer-area { padding-bottom: 18px; }
+
+/* ---------- details panel ---------- */
+.details { background: var(--color-bg-sidebar); }
+.details__who { align-items: flex-start; }
+.details__who .btn { margin-top: 3px; }
+.details__who-head { flex-wrap: wrap; row-gap: 3px; }
+.details__who-name { flex: 1 1 100%; }
+.details__model { flex: 0 1 auto; max-width: 100%; padding: 1px 7px; border-radius: 6px; }
+.details__who-sub { margin-top: 3px; }
+.section-label {
+  font-size: 11px; line-height: 16px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase;
+  color: var(--color-text-tertiary);
+}
+.section-label .link-btn, .section-label button { text-transform: none; letter-spacing: 0; font-weight: 400; }
+.panel-card, .usage-meter { border-radius: 16px; }
+.usage-meter { padding: 14px; gap: 10px; }
+.usage-meter__head { font-size: 11px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: var(--color-text-tertiary); }
+.usage-meter__bar { height: 5px; }
+.usage-meter__val { font-variant-numeric: tabular-nums; }
+.details__tabs .segmented button.is-active { color: var(--color-ink); }
+
+/* ---------- buttons, menus, modals ---------- */
+.btn { transition: background-color 140ms var(--ease-out), opacity 140ms, transform 140ms var(--ease-out), box-shadow 140ms var(--ease-out); }
+.btn:active:not(:disabled) { transform: scale(0.98); }
+.menu { border-radius: 14px; padding: 5px; }
+.menu__item { height: 34px; border-radius: 9px; }
+.modal-scrim { backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
+.modal { border-radius: 20px; }
+.modal__header { padding: 18px 18px 16px; }
+.modal__title { font-size: 15px; }
+.toast, .app-notice { box-shadow: 0 10px 30px #00000040; }
+
+/* ---------- sign-in ---------- */
+.signin {
+  background:
+    radial-gradient(640px 380px at 50% 28%, var(--color-accent-soft), transparent 70%),
+    var(--color-bg-sidebar);
+}
+.signin__card { width: 380px; padding: 44px 32px 32px; border-radius: 28px; }
+.signin__title { font-size: 26px; line-height: 32px; letter-spacing: -0.5px; }
+.signin__sub { margin: 8px 0 28px; max-width: 280px; }
+.signin__dev { gap: 10px; margin-top: 0; }
+.signin__dev + .signin__dev, .signin__google { margin-top: 16px; }
+.signin .text-input { height: 46px; padding: 0 14px; font-size: 15px; border-radius: 12px; }
+.signin .btn { height: 46px; font-size: 15px; margin-top: 4px; }
+.signin .btn--primary { background: var(--color-accent); color: var(--color-on-accent); font-weight: 600; }
+.signin .btn--primary:hover:not(:disabled) { background: var(--color-accent); filter: brightness(1.06); }
+
+/* ---------- empty states ---------- */
+.tasks-empty > svg, .tasks-empty > span:first-child {
+  box-sizing: content-box; padding: 14px; border-radius: 50%;
+  background: var(--color-bg-tertiary); box-shadow: inset 0 0 0 0.5px var(--color-border-tertiary);
+}
+.empty-chat__title { font-size: 19px; letter-spacing: -0.2px; }
+
+/* ---------- phones ---------- */
+@media (max-width: 760px) {
+  .chat__header { height: 68px; padding-top: 10px; }
+  .transcript { padding: 68px 12px 12px; }
+  .chat__menu-btn { top: 10px; }
+  .chat__header-right { top: 10px; }
+  .chat__header .icon-btn, .chat__menu-btn, .chat__chats-btn { width: 40px; height: 40px; }
+  .chat__pill { padding: 9px 14px 9px 9px; }
+  .bubble { max-width: 88%; }
+  .group.is-right .bubble-wrap, .group.is-left .bubble-wrap { max-width: 100%; }
+  .composer { min-height: 54px; }
+  .composer__btn, .composer__cta { width: 36px; height: 36px; }
+  .composer__right, .composer__plus-anchor { padding: 9px 0; }
+  .bot-row { height: 62px; }
+  .sidebar .icon-btn { width: 40px; height: 40px; }
+  .signin__card { width: calc(100% - 32px); padding: 36px 22px 26px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .btn:active:not(:disabled) { transform: none; }
+}
-- 
